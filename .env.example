ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

ARXIV_CATEGORIES=["cs.AI","cs.LG","cs.CL","cs.CV","cs.NE","stat.ML"]
ARXIV_MAX_RESULTS=20
ARXIV_RECENCY_DAYS=1095
ARXIV_REQUEST_DELAY_SECONDS=3
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_TIMEOUT_SECONDS=30
ARXIV_CACHE_TTL_HOURS=24
ARXIV_MIN_RESULTS=5
ARXIV_MAX_KEYWORDS=5

MAX_PDF_PAGES=30
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_CANDIDATE_POOL=40
RETRIEVAL_TOP_K=8

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500

ALPHA_INIT=0.70
BETA_INIT=0.15
GAMMA_INIT=0.15
WEIGHT_MIN=0.05
WEIGHT_MAX=0.90
WEIGHT_LEARNING_RATE=0.10
RECENCY_HALF_LIFE_DAYS=365
